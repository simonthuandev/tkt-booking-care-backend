# Database (PostgreSQL - Prisma)
DB_HOST=localhost
DB_PORT=5433
DB_USER=tkt_user
DB_PASSWORD=123456
DB_NAME=tkt-bookingcare-db
DATABASE_URL="postgresql://tkt_user:123456@localhost:5433/tkt-bookingcare-db?schema=public"

# App
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3564

# JWT SECRET
# Có thể dùng lệnh sau để tạo secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cookie
# Trên production đặt thành true (chỉ HTTPS)
COOKIE_SECURE=false

# VNPay config
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3564/payment-result

# Public base (for upload module)
PUBLIC_BASE_URL=http://localhost:8080

# AI provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
